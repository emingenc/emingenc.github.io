{
  "name": "Emin Gench — Portfolio Agent",
  "version": "2.0.0",
  "description": "Browser-based AI agent representing Emin Gench, Forward Deployed AI Engineer at Cresta AI. ReAct agent loop, multi-tool chains, needle-onnx intent classification + text generation. 100% client-side, 134MB ONNX models.",
  "base_url": "https://emingenc.github.io",

  "endpoints": {
    "tools": "/agent.json",
    "skills": "/skills/{name}.md",
    "llms": "/llms.txt",
    "llms_full": "/llms-full.txt",
    "static_portfolio": "/static"
  },

  "url_api": {
    "description": "Invoke the agent via URL — no server needed, works with static hosting.",
    "hash_routes": {
      "/#/about": "Auto-run /about on load",
      "/#/repos": "Auto-run /repos on load",
      "/#/g1": "Auto-run /g1 on load",
      "/#/contact": "Auto-run /contact on load",
      "/#/skills": "Auto-run /skills on load",
      "/#/help": "Auto-run /help on load",
      "/#/blog": "Navigate to /blog",
      "/#/q/{question}": "Auto-submit natural language query on load"
    },
    "query_params": {
      "?q={question}": "Auto-submit query on load",
      "?ask={question}": "Alias for ?q=",
      "?query={question}": "Alias for ?q="
    },
    "examples": [
      "https://emingenc.github.io/#/about",
      "https://emingenc.github.io/#/q/who+is+emin",
      "https://emingenc.github.io/?q=what+does+emin+do",
      "https://emingenc.github.io/#/repos"
    ]
  },

  "tools": [
    {"name": "about", "description": "Bio, background, career timeline", "deterministic": true},
    {"name": "repos", "description": "Open source projects with star counts", "deterministic": true},
    {"name": "contact", "description": "Email, GitHub, LinkedIn, Twitter", "deterministic": true},
    {"name": "skills", "description": "Tech stack and domains", "deterministic": true},
    {"name": "blog", "description": "Latest blog posts and links", "deterministic": true},
    {"name": "g1", "description": "Smart glasses ecosystem architecture", "deterministic": true},
    {"name": "help", "description": "List all available commands", "deterministic": true},
    {"name": "ask_user", "description": "Pause agent loop for human input (consent, clarification)", "deterministic": true}
  ],

  "routing": {
    "engine": "needle-onnx (encoder.onnx, 53MB)",
    "method": "encoder embedding + cosine similarity",
    "fallback": "keyword-based multi-intent scoring → FAQ matcher → needle decoder text generation",
    "multi_tool": "Compound queries chain up to 3 tools (ReAct execute plan)"
  },

  "llm": {
    "model": "needle-onnx decoder (decoder_step.onnx, 81MB)",
    "runtime": "ONNX Runtime Web (WASM)",
    "architecture": "Character-level encoder-decoder transformer",
    "load": "Lazy on user consent (opt-in, 81MB download)",
    "total_models": "134MB (53MB encoder + 81MB decoder)"
  },

  "architecture": {
    "pattern": "ReAct agent loop (12 Factor Agents — 12/12 compliant)",
    "modules": ["store (reducer + persist)", "tools (pure functions)", "router (ReAct loop)", "renderer (DOM)", "needle-router (worker)", "needle-decoder (worker)"],
    "state": "Single-store reducer pattern with localStorage persist/restore",
    "repo": "https://github.com/emingenc/emingenc.github.io"
  },

  "contact": {
    "name": "Emin Gench",
    "email": "emin@emingenc.com",
    "github": "https://github.com/emingenc",
    "linkedin": "https://linkedin.com/in/emingench",
    "twitter": "https://twitter.com/emingench"
  },

  "for_ai_agents": {
    "how_to_use": "Fetch this file (/agent.json) to discover tools and URL API. Use /llms.txt for static context. Invoke tools via URL hash routes (/#/about) or query params (?q=...). All responses are deterministic HTML rendered client-side — no auth, no API keys, no server.",
    "url_scheme": "https://emingenc.github.io/#/{tool} or https://emingenc.github.io/?q={natural language query}",
    "schema_org": "Person (JSON-LD in page head)",
    "crawlers_allowed": ["GPTBot", "ClaudeBot", "PerplexityBot", "OAI-SearchBot", "Google-Extended", "CCBot", "anthropic-ai", "cohere-ai", "Diffbot", "FacebookBot", "AppleBot"]
  }
}
